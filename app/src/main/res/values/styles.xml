<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Safari" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/safari_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.Safari.Dark" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/safari_bg_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

</resources>
